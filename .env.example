# CartaLista · variables de entorno
# Copiá este archivo a .env.local (desarrollo) o cargalas en tu proveedor de hosting.
# Nunca subas claves reales al repositorio.

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
# URL pública base. Se usa en los QR, enlaces de invitación y metadatos.
# En producción: la URL definitiva (los QR impresos apuntan acá: no la cambies después).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Local: `npm run db:start` y copiá los valores de `npx supabase status`.
# Alojado: Project Settings → API Keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_...). Es pública por diseño: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...). SOLO servidor y worker. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Compatibilidad con proyectos que todavía usan las claves legadas (opcional):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Solo para las pruebas de integración (base local). No hace falta en producción.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# IA para leer fotos de cartas: xai (Grok, pago por uso) o gemini (Google, con
# nivel gratuito). Sin la clave del proveedor elegido, la carga manual, la
# publicación y la carta pública funcionan igual; la opción de fotos se muestra
# como "necesita configuración". La clave puede estar solo en el worker (recomendado).
# ---------------------------------------------------------------------------
AI_PROVIDER=xai

# Gemini (AI_PROVIDER=gemini). Clave: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# minimal | low | medium | high (opcional; por defecto, el del modelo)
GEMINI_THINKING_LEVEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=300000
GEMINI_MAX_OUTPUT_TOKENS=32000

# Grok (AI_PROVIDER=xai). Clave: https://console.x.ai (empieza con "xai-")
XAI_API_KEY=
XAI_MODEL=grok-4.7
# low | medium | high | xhigh (opcional; solo para modelos con razonamiento configurable)
XAI_REASONING_EFFORT=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_MS=180000
XAI_MAX_OUTPUT_TOKENS=16000

# Proveedor simulado: SOLO pruebas o desarrollo explícito (nunca en producción).
# Para usarlo en desarrollo: AI_PROVIDER=mock y ALLOW_MOCK_AI=true. Sus resultados
# se muestran siempre como "Resultado simulado".
ALLOW_MOCK_AI=false

# ---------------------------------------------------------------------------
# Importaciones con fotos
# ---------------------------------------------------------------------------
IMPORT_MAX_IMAGE_MB=12
IMPORT_MIN_IMAGE_SIDE_PX=600
IMPORT_MAX_IMAGE_SIDE_PX=12000
IMPORT_MAX_ATTEMPTS=3
# Minutos tras los que se cancela una importación cuyas fotos nunca terminaron de subir.
IMPORT_UPLOAD_TTL_MINUTES=1440

# ---------------------------------------------------------------------------
# Worker (procesador de fotos)
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=3000
WORKER_LEASE_SECONDS=300
